[gd_resource type="OpenXRActionMap" load_steps=15 format=3]

[sub_resource type="OpenXRAction" id="OpenXRAction_aim"]
resource_name = "aim_pose"
localized_name = "Aim pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_trigger"]
resource_name = "trigger_click"
localized_name = "Trigger select"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRActionSet" id="OpenXRActionSet_phios"]
resource_name = "phios"
localized_name = "PhiOS XR Navigation"
actions = [SubResource("OpenXRAction_aim"), SubResource("OpenXRAction_trigger")]

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_left_aim"]
action = SubResource("OpenXRAction_aim")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_left_select"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/left/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_right_aim"]
action = SubResource("OpenXRAction_aim")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_right_select"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRInteractionProfile" id="OpenXRInteractionProfile_touch"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("OpenXRIPBinding_touch_left_aim"), SubResource("OpenXRIPBinding_touch_left_select"), SubResource("OpenXRIPBinding_touch_right_aim"), SubResource("OpenXRIPBinding_touch_right_select")]

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_left_aim"]
action = SubResource("OpenXRAction_aim")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_left_select"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/left/input/select/click"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_right_aim"]
action = SubResource("OpenXRAction_aim")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_right_select"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/right/input/select/click"

[sub_resource type="OpenXRInteractionProfile" id="OpenXRInteractionProfile_simple"]
interaction_profile_path = "/interaction_profiles/khr/simple_controller"
bindings = [SubResource("OpenXRIPBinding_simple_left_aim"), SubResource("OpenXRIPBinding_simple_left_select"), SubResource("OpenXRIPBinding_simple_right_aim"), SubResource("OpenXRIPBinding_simple_right_select")]

[resource]
action_sets = [SubResource("OpenXRActionSet_phios")]
interaction_profiles = [SubResource("OpenXRInteractionProfile_touch"), SubResource("OpenXRInteractionProfile_simple")]
