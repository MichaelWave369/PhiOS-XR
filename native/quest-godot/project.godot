; Engine configuration file.
; PhiOS XR Edition 06 - experimental native OpenXR shell.
; This project has not been built or verified on a physical Quest 3.

config_version=5

[application]

config/name="PhiOS XR Native"
config/description="Experimental native OpenXR spatial shell; not an operating system"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

; Required to validate Android export from headless x86_64 Godot 4.6 editors.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.02, 0.04, 0.08, 1)

[xr]

openxr/enabled=true
openxr/default_action_map="res://openxr_action_map.tres"
shaders/enabled=true
